LIBRARY ieee ;
USE ieee.std_logic_1164.all ;
ENTITY sseg7 IS
	PORT (bcd : IN STD_LOGIC_VECTOR(3 DOWNTO 0) ;
	neg : IN STD_LOGIC;

	leds, ledss : OUT STD_LOGIC_VECTOR(0 TO 6) ) ;
END sseg7 ;

ARCHITECTURE Behavior OF sseg7 IS
BEGIN
	PROCESS (bcd, neg)
	BEGIN
		IF neg = '1' THEN
		ledss <="1111110"; --turn on the negative tick
	ELSE
		ledss<="1111111"; --all negative ticks off
	END IF;
	CASE bcd IS --               abcdefg
			WHEN "0000" => leds <="1000100"; --y
			WHEN "0001" => leds <="0001001"; --n
			WHEN "0010" => leds <="1000100";
			WHEN "0011" => leds <="0001001";
			WHEN "0100" => leds <="1000100";
			WHEN "0101" => leds <="0001001";
			WHEN "0110" => leds <="1000100";
			WHEN "0111" => leds <="0001001";
			WHEN "1000" => leds <="1000100";
			WHEN "1001" => leds <="0001001";
			WHEN "1010" => leds <="1000100";
			WHEN "1011" => leds <="0001001";
			WHEN "1100" => leds <="1000100";
			WHEN "1101" => leds <="0001001";
			WHEN "1110" => leds <="1000100";
			WHEN "1111" => leds <="0001001";
			WHEN OTHERS => leds <= "1111111";
		END CASE;
	END PROCESS;
END Behavior;
			