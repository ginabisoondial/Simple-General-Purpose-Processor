library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.NUMERIC_STD.ALL;
entity ALU_MOD is
port( Clk : in std_logic; --input clock signal
      A :in unsigned(7 downto 0); --8-bit inputs from latches A and B
      B : in unsigned(7 downto 0); --8-bit student ID from FSM
      OP : in unsigned(15 downto 0); --6-bit selector for Operation from Decoder
      Neg: out std_logic; --is the result negative? Set=for 8-bit output
      R1 : out unsigned(3 downto 0); -- lower 4-bits of 8-bit Result Output
      R2 : out unsigned(3 downto 0)); -- higher 4-bits of 8-bit Result Output
end ALU_MOD;
architecture calculation of ALU_MOD is --temporary signal declarations.
signal Reg1,Reg2, Result:unsigned(7 downto 0) := (others => '0');
--signal Reg4 : unsigned (7 to 7);
begin
Reg1 <= A; --temporary store A in Reg1 local variable
Reg2 <= B; --temporary store B in Reg2 local variable
process(Clk)
begin
    if(rising_edge(Clk)) THEN --Do the calculation @ positive edge of clock cycle.
        case OP is
            WHEN "0000000000000001" => 
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                -- Do Addition for Reg1 and Reg2
            WHEN "0000000000000010"=>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Subtraction
                --Do shift of test if required.
            WHEN "0000000000000100" => 
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                -- Do Inverse
            WHEN "0000000000001000" =>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean NAND
            WHEN "0000000000010000" =>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean NOR
            WHEN "0000000000100000" =>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean AND
            WHEN "0000000001000000" =>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean XOR
            WHEN "0000000010000000" =>
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean OR
            WHEN "0000000100000000" => 
					IF (Reg2 rem 2 = 0) THEN
						Result <= '0';
					ELSE
						Result <= '1';
					END IF;
                --Do Boolean XNOR
            WHEN OTHERS => 
					Result <= Result;
                --Don’t care, do nothing
        end case;
    end if;
end process;
R1 <= Result(3 downto 0); --Since the output seven segments can
R2 <= Result(7 downto 4); -- only 4-bits, split the 8-bit to two 4-bits.
end calculation;
